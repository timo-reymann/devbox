#!/bin/sh

CODE_SERVER_PORT="${CODE_SERVER_PORT:-8082}"

mkdir -p /data/code-server/user-data \
         /data/code-server/extensions

exec code-server \
    --bind-addr "127.0.0.1:${CODE_SERVER_PORT}" \
    --auth none \
    --app-name "Code Server" \
    --user-data-dir /data/code-server/user-data \
    --extensions-dir /data/code-server/extensions \
    --disable-getting-started-override \
    --vscode-option chat.disableAIFeatures=true \
    --vscode-option chat.agent.enabled=false
